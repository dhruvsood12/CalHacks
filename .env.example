# Copy to .env and fill in locally. .env is gitignored. Never commit real values.
ANTHROPIC_API_KEY=
# serve/: stub until A's artifact exists, then model
CLASSIFIER=stub
MODEL_ARTIFACT_DIR=artifacts/latest
# mobile/: Expo reads mobile/.env, not this file. Put these two there:
# the serve API's public URL (cloudflared tunnel) and the Convex deployment URL.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_CONVEX_URL=
